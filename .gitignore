# Secrets -- never commit
.env
*.key

# Data and model caches (regenerated by the code)
data/
cache_store/
results/figures/*.png
!results/.gitkeep

# Result JSONs ARE tracked: they are the evidence for the manuscript revision,
# they are small (~100 KB total), and exp8/exp9 read them. Regenerating them
# costs hours of encoder time, so a fresh clone should not have to.
!results/raw/
!results/raw/*.json
!results/raw/*.log

# The prefetched LLM answer pool is tracked too, so re-running the end-to-end
# experiment does not re-pay for the same API calls. Contains model answers
# only -- no credentials.
!data/
data/*
!data/llm_cache/
data/llm_cache/*
!data/llm_cache/*.jsonl

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.venv-lightning/
manuscript/

# Local environments, logs, nested Overleaf clones (snapshot is tracked instead)
.venv-vast/
results/logs/
manuscript_v2/
manuscript_v3/
